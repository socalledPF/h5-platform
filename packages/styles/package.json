{
  "name": "@h5/styles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "纯 CSS 包：入口即样式表，业务通过 import '@h5/styles' 引入；不产出 JS 类型。",
  "main": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./variables.css": "./src/variables.css",
    "./reset.css": "./src/reset.css",
    "./safe-area.css": "./src/safe-area.css",
    "./utilities.css": "./src/utilities.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "echo '@h5/styles: css-only package'",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}

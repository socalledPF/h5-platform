# 环境标识：dev=本地 / test=测试包 / pre=预发 / prod=线上。
# 仅影响前端行为分支（vConsole、日志级别、mock 开关），不改变构建产物结构。
VITE_APP_ENV=dev

# 接口域名：只在本地 dev 生效，vite 会以此为 /api 的代理目标，规避跨域。
# test/pre/prod 由 Nginx 与 App WebView 直接回源，通常留空。
VITE_API_BASE_URL=

# 静态资源域名：构建时作为 vite base，例如 https://cdn.xxx.com/h5/member/0.1.0/
# 留空则使用根路径 /（本地与 Nginx 同域部署的默认值）。
VITE_CDN_BASE=

# 应用 ID：构建时注入为 __APP_ID__，用于监控/埋点/日志区分业务。
# 留空则回落到 vite.config.ts 中的 appId（member / activity / bridge-playground）。
VITE_APP_ID=

# 包体积分析开关：1 或 true 时构建额外产出 dist/stats.html，默认关闭。
ANALYZE=

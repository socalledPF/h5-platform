{
  "name": "h5-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:scripts && pnpm typecheck:workspaces",
    "typecheck:workspaces": "turbo run typecheck --dry=json | node -e \"const fs=require('node:fs');const p=JSON.parse(fs.readFileSync(0,'utf8'));const declared=new Set((p.tasks||[]).map(t=>t.package));const missing=(p.packages||[]).filter(n=>!declared.has(n));if(missing.length){console.error('[@h5/typecheck] 以下 workspace 没有 typecheck 脚本，turbo 会静默跳过：'+missing.join(', '));process.exit(1)}console.log('[@h5/typecheck] '+declared.size+'/'+p.packages.length+' 个 workspace 都声明了 typecheck（无静默跳过）')\"",
    "lint": "eslint . --max-warnings 0",
    "lint:style": "stylelint \"**/*.{css,vue}\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && turbo run test",
    "test:coverage": "vitest run --coverage && pnpm coverage:packages",
    "coverage:packages": "pnpm --filter @h5/bridge --filter @h5/core --filter @h5/monitor --filter @h5/hooks --filter @h5/ui exec vitest run --coverage",
    "size:check": "node --experimental-strip-types scripts/check-bundle-size.ts",
    "clean": "rm -rf node_modules coverage .turbo apps/*/dist apps/*/coverage packages/*/dist packages/*/coverage",
    "create:app": "node --experimental-strip-types scripts/create-app.ts",
    "deploy": "node --experimental-strip-types scripts/deploy.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@h5/config": "workspace:*",
    "@playwright/test": "~1.61.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "postcss-html": "^1.7.0",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "turbo": "^2.11.11",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  }
}

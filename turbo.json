{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["VITE_APP_ENV", "VITE_API_BASE_URL", "VITE_CDN_BASE", "VITE_APP_ID", "ANALYZE"],
  "globalDependencies": ["tsconfig.base.json", "packages/config/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:style": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
